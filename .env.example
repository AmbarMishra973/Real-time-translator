# Groq API Configuration (Optional: Free tier LPU inference for <300ms translation)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (Optional)
OPENAI_API_KEY=

# Faster-Whisper Local STT Configuration (100% Zero-Cost Local Inference)
STT_ENGINE=local
WHISPER_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Default LLM Provider (groq / fallback)
DEFAULT_LLM_PROVIDER=groq

# Debug & Diagnostics
STT_DEBUG=false
STT_DEBUG_SAVE_AUDIO=false
