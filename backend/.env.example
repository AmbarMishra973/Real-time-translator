# Groq API Configuration (Cloud LLM translation)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI Configuration (Optional fallback tier)
OPENAI_API_KEY=

# Faster-Whisper Local STT Configuration (In-memory CPU inference)
STT_ENGINE=local
WHISPER_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Voice Activity Detection (VAD) / Endpointing (Optional, disabled by default)
VAD_ENABLED=false
VAD_THRESHOLD=0.5

# Hypothesis Stabilization / Local Agreement (Streaming ASR)
HYPOTHESIS_STABILIZATION_ENABLED=true
STABILITY_MIN_AGREEMENTS=2

# Terminology & Context RAG (Selective terminology-gated TF-IDF)
RAG_MODE=selective
SELECTIVE_RAG_ENABLED=true

# Text-to-Speech (Edge-TTS cloud synthesis)
TTS_ENGINE=edge

# Default LLM Provider (groq / openai / fallback)
DEFAULT_LLM_PROVIDER=groq

