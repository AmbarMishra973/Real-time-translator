# LLM Configuration (Optional - Groq free tier recommended for <300ms latency)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (Optional)
OPENAI_API_KEY=

# Whisper Configuration
WHISPER_SIZE=small
WHISPER_DEVICE=cpu

# Default LLM Provider (groq / openai / fallback)
DEFAULT_LLM_PROVIDER=groq
